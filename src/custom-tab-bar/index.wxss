.custom-tabbar {
  box-sizing: border-box;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  height: calc(62px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: #fffcf5;
  box-shadow: inset 0 1px 0 #e6dfd2;
}
.custom-tab {
  flex: 1;
  min-width: 0;
  position: relative;
  height: 62px;
  color: #504c43;
}
.custom-tab-content {
  position: absolute;
  top: 4px;
  left: 50%;
  transform: translateX(-50%);
  box-sizing: border-box;
  width: 72px;
  max-width: calc(100% - 8px);
  height: 54px;
  padding: 6px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border-radius: 10px;
}
.custom-tab-content-active {
  background: #e7d6b7;
}
.custom-tab-content image {
  flex-shrink: 0;
  width: 21px;
  height: 21px;
}
.custom-tab-label {
  max-width: 100%;
  font-size: 12px;
  line-height: 18px;
  text-align: center;
  white-space: nowrap;
}
.custom-tab-label-active {
  color: #36524e;
  font-weight: 500;
}
