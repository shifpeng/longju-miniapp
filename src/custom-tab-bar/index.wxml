<view class="custom-tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="custom-tab"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="custom-tab-icon {{selected === index ? 'custom-tab-icon-active' : ''}}">
      <image
        src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
        mode="aspectFit"
      />
    </view>
    <view class="custom-tab-label {{selected === index ? 'custom-tab-label-active' : ''}}">
      {{item.text}}
    </view>
  </view>
</view>
