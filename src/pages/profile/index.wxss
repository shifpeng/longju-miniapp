.profile-review {
  border: 1px solid #dfc59d;
  border-left: 4px solid #a87936;
  background: #fbf1df;
}
.profile-review .section {
  margin: 0 0 8px;
  color: #79501f;
  font-size: 16px;
}
.profile-review-reason {
  display: block;
  margin-top: 12px;
  color: #49351e;
  font-size: 15px;
  line-height: 24px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
