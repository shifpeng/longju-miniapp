.application-page {
  padding-bottom: calc(160px + env(safe-area-inset-bottom));
}
.application-page > .title {
  margin-bottom: 4px;
}
.application-review {
  margin: 16px 0;
  padding: 16px;
  border: 1px solid #dfc59d;
  border-left: 4px solid #a87936;
  border-radius: 12px;
  background: #fbf1df;
}
.application-review-heading {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #79501f;
  font-size: 14px;
  line-height: 22px;
  font-weight: 600;
}
.application-review-mark {
  flex: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #ead4b0;
  text-align: center;
  line-height: 22px;
}
.application-review-reason {
  display: block;
  margin-top: 12px;
  color: #49351e;
  font-size: 16px;
  line-height: 26px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.application-review-hint {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #e7d8be;
  color: #756044;
  font-size: 12px;
  line-height: 20px;
}
.application-page > .muted.body {
  font-size: 14px;
  line-height: 22px;
}
.application-progress {
  display: flex;
  align-items: center;
  gap: 8px;
  overflow: hidden;
  color: #504c43;
  font-size: 12px;
  line-height: 20px;
  white-space: nowrap;
}
.application-step {
  flex: 1;
  min-width: 0;
}
.application-step-current {
  color: #36524e;
}
.application-sticky {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 10px 20px calc(10px + env(safe-area-inset-bottom));
  background: #fffcf5;
  box-shadow: 0 -4px 20px #2927200d;
}
.application-consent {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 28px;
  color: #504c43;
  font-size: 12px;
  line-height: 18px;
}
.application-consent checkbox {
  transform: scale(0.85);
  transform-origin: left center;
}
.application-agreement-note {
  color: #504c43;
  font-size: 12px;
  line-height: 18px;
}
button.application-submit {
  width: 100%;
  margin-top: 8px;
  min-height: 46px;
  font-size: 14px;
}
