.activity-detail-page {
  padding-bottom: calc(116px + env(safe-area-inset-bottom));
}
.activity-detail-page > .cover {
  display: block;
  height: 194px;
  margin-bottom: 16px;
  border-radius: 16px;
}
.activity-detail-page > .title {
  margin: 8px 0 14px;
  font-size: 22px;
  line-height: 30px;
}
.activity-detail-page > .section {
  margin: 20px 0 8px;
  font-size: 18px;
  font-weight: 500;
}
.activity-detail-page > .card {
  margin: 12px 0;
}
.activity-detail-page .activity-intro {
  white-space: pre-wrap;
  font-size: 14px;
  line-height: 24px;
}
.activity-detail-page .photo-grid {
  margin-top: 14px;
}
.activity-detail-page .photo-grid image {
  height: 110px;
}
.activity-sticky {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 20px calc(10px + env(safe-area-inset-bottom));
  background: #fffcf5;
  box-shadow: 0 -4px 20px #2927200d;
}
.activity-sticky > button {
  flex: 1;
  margin: 0;
  min-height: 46px;
  font-size: 14px;
}
.activity-sticky .activity-footer-primary {
  background: linear-gradient(110deg, #cfb17e, #e2cba5);
}
.activity-sticky .activity-footer-secondary {
  background: #faf7f0;
  border: 1px solid #d6cebf;
  color: #4e594e;
}
.activity-facts {
  display: flex;
  flex-direction: column;
  gap: 6px;
  overflow-wrap: anywhere;
}
.activity-facts-time {
  font-size: 16px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.activity-facts .muted {
  font-size: 13px;
}
.activity-footer-note {
  flex: 1;
  min-width: 0;
  color: #504c43;
  font-size: 12px;
  line-height: 18px;
}
@media (max-width: 375px) {
  .activity-detail-page > .cover {
    height: 160px;
    margin-bottom: 12px;
  }
}
.activity-rules-toggle {
  width: auto;
  margin: 4px 0;
  padding: 8px 0;
  min-height: 44px;
  text-align: left;
  font-size: 13px;
}
.activity-rules {
  padding: 14px 16px;
  border-radius: 12px;
  background: #eee7d9;
  color: #665f53;
  font-size: 13px;
  line-height: 22px;
  animation: recap-fade 180ms ease-out;
}
.recap-layer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.recap-shade {
  position: absolute;
  inset: 0;
  background: rgba(25, 28, 26, 0.4);
  animation: recap-fade 220ms ease-out;
}
.recap-sheet {
  position: relative;
  width: 100%;
  max-width: 500px;
  border-radius: 24px 24px 0 0;
  overflow: hidden;
  background: #fffcf5;
  box-shadow: 0 -8px 40px #29272026;
  animation: recap-rise 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
}
.recap-photo-stage {
  position: relative;
  background: #242723;
}
.recap-photo-swiper {
  height: 34vh;
  max-height: 320px;
}
.recap-photo {
  display: block;
  width: 100%;
  height: 100%;
}
.recap-photo-stage .recap-close {
  position: absolute;
  z-index: 2;
  top: 12px;
  right: 12px;
  width: 44px;
  min-width: 44px;
  max-width: 44px;
  height: 44px;
  min-height: 44px;
  max-height: 44px;
  flex: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(25, 28, 26, 0.6);
  color: #fff;
  line-height: 1;
}
.recap-close::after {
  border: 0;
}
.recap-close-icon {
  position: relative;
  width: 18px;
  height: 18px;
  pointer-events: none;
}
.recap-close-icon::before,
.recap-close-icon::after {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  width: 18px;
  height: 2px;
  border-radius: 1px;
  background: #fff;
  transform: rotate(45deg);
}
.recap-close-icon::after {
  transform: rotate(-45deg);
}
.recap-photo-count {
  position: absolute;
  left: 16px;
  bottom: 36px;
  padding: 2px 10px;
  border-radius: 12px;
  background: rgba(25, 28, 26, 0.6);
  color: #fff;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
}
.recap-drawer {
  position: relative;
  height: 38vh;
  margin-top: -22px;
  border-radius: 22px 22px 0 0;
  background: #fffcf5;
}
.recap-drawer-content {
  padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
  overflow-wrap: anywhere;
}
.recap-eyebrow {
  color: #827154;
  font-size: 11px;
}
.recap-heading {
  margin-top: 6px;
  font-size: 20px;
  line-height: 28px;
  font-weight: 600;
}
.recap-caption {
  margin-top: 10px;
  padding-left: 10px;
  border-left: 2px solid #c9af80;
  color: #665f53;
  font-size: 13px;
  white-space: pre-wrap;
}
.recap-copy {
  margin-top: 12px;
  color: #665f53;
  font-size: 14px;
  line-height: 24px;
  white-space: pre-wrap;
}
.recap-copy-collapsed {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.recap-expand {
  width: auto;
  min-height: 44px;
  margin: 4px 0 0;
  padding: 8px 0;
  font-size: 13px;
}
.recap-original {
  margin-top: 14px;
  min-height: 46px;
}
@keyframes recap-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes recap-rise {
  from {
    opacity: 0;
    transform: translateY(28px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (prefers-reduced-motion: reduce) {
  .recap-shade,
  .recap-sheet,
  .activity-rules {
    animation: none;
  }
}
