.activity-detail-page {
  padding-bottom: calc(116px + env(safe-area-inset-bottom));
}
.activity-detail-page > .cover {
  display: block;
  height: 194px;
  margin-bottom: 16px;
  border-radius: 16px;
}
.activity-detail-page > .title {
  margin: 8px 0 14px;
  font-size: 22px;
  line-height: 30px;
}
.activity-detail-page > .section {
  margin: 20px 0 8px;
  font-size: 18px;
  font-weight: 500;
}
.activity-detail-page > .card {
  margin: 16px 0;
}
.activity-detail-page .activity-intro {
  white-space: pre-wrap;
  font-size: 14px;
  line-height: 24px;
}
.activity-detail-page .photo-grid {
  margin-top: 14px;
}
.activity-detail-page .photo-grid image {
  height: 110px;
}
.activity-sticky {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 20px calc(10px + env(safe-area-inset-bottom));
  background: #fffcf5;
  box-shadow: 0 -4px 20px #2927200d;
}
.activity-sticky > button {
  flex: 1;
  margin: 0;
  min-height: 46px;
  font-size: 14px;
}
.activity-sticky .activity-footer-primary {
  background: linear-gradient(
    112deg,
    #c49b59,
    #d9ba80 17%,
    #e4c792 39%,
    #cfa96b 62%,
    #dfc18a 82%,
    #c9a266
  );
}
.activity-sticky .activity-footer-secondary {
  background: #fffcf5;
  border: 1px solid #bfa77e;
  color: #68481d;
}
.activity-footer-note {
  flex: 1;
  min-width: 0;
  color: #504c43;
  font-size: 12px;
  line-height: 18px;
}
