<custom-nav title="活动" />
<view class="page activity-list-page">
  <view class="title">近期活动</view>
  <view class="muted">以乡情为约，让每次相聚有所收获。</view>
  <view class="filters">
    <button class="{{lifecycle === '' ? '' : 'secondary'}}" data-value="" bindtap="filter">
      全部
    </button>
    <button
      class="{{lifecycle === 'UPCOMING' ? '' : 'secondary'}}"
      data-value="UPCOMING"
      bindtap="filter"
    >
      即将开始
    </button>
    <button
      class="{{lifecycle === 'ENDED' ? '' : 'secondary'}}"
      data-value="ENDED"
      bindtap="filter"
    >
      已结束
    </button>
  </view>
  <activity-card wx:for="{{items}}" wx:key="id" item="{{item}}" />
  <load-status
    loading="{{loading}}"
    error="{{error}}"
    empty="{{!items.length}}"
    empty-text="暂时没有活动"
    bind:retry="retry"
  />
  <button wx:if="{{items.length < total && !loading}}" class="secondary" bindtap="retry">
    加载更多
  </button>
</view>
