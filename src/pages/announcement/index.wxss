.announcement-page .title {
  margin: 72px 0 10px;
  font-size: 22px;
  line-height: 30px;
}
.announcement-page > .muted {
  font-size: 12px;
  line-height: 20px;
}
.announcement-rule {
  height: 1px;
  margin: 18px 0;
  background: #e0d8c8;
}
.announcement-body {
  white-space: pre-wrap;
  overflow-wrap: break-word;
  display: block;
  color: #292720;
  font-size: 14px;
  line-height: 24px;
}
