<custom-nav title="老乡资料" back />
<view class="page">
  <load-status loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <view wx:if="{{member}}" class="card member-detail">
    <view class="member-detail-header">
      <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
      <view class="member-detail-identity">
        <view class="title">{{member.name}}</view>
        <view class="muted member-detail-meta">
          {{member.hometownLabel}} · {{member.residenceLabel}}
        </view>
      </view>
    </view>
    <view class="member-detail-tags"><text class="badge">{{member.industryLabel}}</text></view>
    <view class="body member-detail-intro">{{member.introduction || '暂未填写个人介绍'}}</view>
    <view wx:if="{{member.helpText}}" class="member-detail-help">
      <view class="section">乐意交流</view>
      <view class="body">{{member.helpText}}</view>
    </view>
    <view class="member-detail-contact muted">
      联系电话仅用于社群运营和活动联系，不向其他成员展示。
    </view>
  </view>
</view>
