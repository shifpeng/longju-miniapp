.confirm-layer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 16px 12px calc(12px + env(safe-area-inset-bottom));
}
.confirm-shade {
  position: absolute;
  inset: 0;
  background: rgba(25, 28, 26, 0.4);
  animation: confirm-fade 220ms ease-out;
}
.confirm-panel {
  position: relative;
  width: 100%;
  max-width: 420px;
  max-height: 100%;
  overflow-y: auto;
  padding: 12px 22px 22px;
  border: 1px solid rgba(255, 252, 245, 0.9);
  border-radius: 24px;
  background: rgba(255, 252, 245, 0.98);
  box-shadow: 0 12px 48px rgba(29, 27, 22, 0.18);
  transform-origin: center bottom;
  animation: confirm-enter 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
}
.confirm-handle {
  width: 32px;
  height: 4px;
  margin: 0 auto 20px;
  border-radius: 2px;
  background: #d9cebc;
}
.confirm-mark {
  width: 40px;
  height: 40px;
  border-radius: 14px;
  background: #eee3cf;
  color: #68481d;
  text-align: center;
  line-height: 40px;
  font-size: 24px;
  margin-bottom: 16px;
}
.confirm-title {
  font-size: 20px;
  font-weight: 600;
  color: #292720;
}
.confirm-content {
  margin-top: 12px;
  font-size: 15px;
  color: #292720;
}
.confirm-detail {
  margin-top: 14px;
  padding: 12px 14px;
  border-radius: 12px;
  background: #f2ecdf;
  font-size: 13px;
  line-height: 1.8;
  color: #6d6557;
}
.confirm-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}
.confirm-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 12px 8px;
}
@keyframes confirm-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes confirm-enter {
  from {
    opacity: 0;
    transform: translateY(28px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
@media (prefers-reduced-motion: reduce) {
  .confirm-shade,
  .confirm-panel {
    animation: none;
  }
}
