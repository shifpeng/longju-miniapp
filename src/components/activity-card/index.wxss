.compact-card {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.compact-card .section {
  margin: 0;
  font-size: 18px;
  font-weight: 500;
  line-height: 26px;
}
.compact-card .muted {
  font-size: 12px;
  line-height: 20px;
}
.compact-card .row > .small {
  flex: 1;
  min-width: 0;
}
.compact-card .row > .muted {
  text-align: right;
}
.compact-card .row:last-child > .muted {
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.activity-summary {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
