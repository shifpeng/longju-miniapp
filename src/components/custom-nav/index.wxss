.custom-nav {
  position: relative;
  width: 100%;
  z-index: 10;
}
.custom-nav-title {
  position: absolute;
  left: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #292720;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.custom-nav-back {
  width: 24px;
  height: 32px;
  flex: 0 0 24px;
  display: flex;
  align-items: center;
}
.custom-nav-back view {
  width: 9px;
  height: 9px;
  margin-left: 5px;
  border-left: 1.5px solid #292720;
  border-bottom: 1.5px solid #292720;
  transform: rotate(45deg);
}
